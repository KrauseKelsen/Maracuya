<resources>
    <declare-styleable name="MyLibraryThemeWrp">
        <attr name="useMaterial" format="boolean" />
        <attr name="themeStyle" format="string" />
        <attr name="themeName" format="string" />
    </declare-styleable>

    <declare-styleable name="PrimaryButtonWrp">
        <attr name="text" format="string" />
        <attr name="showProgressOnPress" format="boolean" />
        <attr name="isEnabled" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ButtonWrp">
        <attr name="text" />
        <attr name="showProgressOnPress" />
        <attr name="isEnabled" />
        <attr name="buttonVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
        </attr>
        <attr name="buttonTokensOverride" format="string" />
    </declare-styleable>

    <declare-styleable name="ButtonNavigationWrp">
        <attr name="buttonNavigationLabel" format="string" />
        <attr name="isEnabled" />
        <attr name="buttonNavigationVariant" format="enum">
            <enum name="primary" value="0" />
            <enum name="secondary" value="1" />
            <enum name="primarysquare" value="2" />
            <enum name="secondarysquare" value="3" />
        </attr>
        <attr name="buttonNavigationIsLoading" format="boolean" />
        <attr name="buttonNavigationStartsLoadingOnClick" format="boolean" />
        <attr name="buttonNavigationShowIcon" format="boolean" />
        <attr name="buttonNavigationTokensOverride" format="string" />
    </declare-styleable>

    <declare-styleable name="ButtonNavigationGroupWrp">
        <attr name="isEnabled" />
        <attr name="buttonNavigationGroupVariant" format="enum">
            <enum name="back_continue" value="0" />
            <enum name="back_submit" value="1" />
            <enum name="skip_continue" value="2" />
            <enum name="skip_submit" value="3" />
        </attr>
        <attr name="buttonNavigationGroupLeadingLabel" format="string" />
        <attr name="buttonNavigationGroupTrailingLabel" format="string" />
        <attr name="buttonNavigationGroupLeadingButtonWidth" format="dimension" />
        <attr name="buttonNavigationGroupTrailingButtonWidth" format="dimension" />
        <attr name="buttonNavigationGroupButtonSpacing" format="dimension" />
        <attr name="buttonNavigationGroupLeadingEnabled" format="boolean" />
        <attr name="buttonNavigationGroupTrailingEnabled" format="boolean" />
        <attr name="buttonNavigationGroupIsTrailingLoading" format="boolean" />
        <attr name="buttonNavigationGroupStartsTrailingLoadingOnClick" format="boolean" />
    </declare-styleable>

    <declare-styleable name="LabelWrp">
        <attr name="text" />
        <attr name="optionalText" format="boolean" />
        <attr name="showIcon" format="boolean" />
        <attr name="error" format="boolean" />
        <attr name="onClickContentDescription" format="string" />
        <attr name="labelTokensOverride" format="string" />
        <attr name="limitMaxLabel" format="boolean" />
    </declare-styleable>
    <declare-styleable name="TextFieldWrp">
        <attr name="textFieldValue" format="string" />
        <attr name="textFieldPinValue" format="string" />
        <attr name="textFieldLabel" format="string" />
        <attr name="textFieldPlaceholder" format="string" />
        <attr name="textFieldLength" format="string" />
        <attr name="isEnabled" />
        <attr name="textFieldReadOnly" format="boolean" />
        <attr name="textFieldHasError" format="boolean" />
        <attr name="optionalText" />
        <attr name="textFieldShowLabelIcon" format="boolean" />
        <attr name="textFieldBottomText" format="string" />
        <attr name="textFieldShowBottomIcon" format="boolean" />
        <attr name="textFieldVariant" format="string" />
        <attr name="textFieldEnableImplicitTrailingClear" format="boolean" />
        <attr name="textFieldTokensOverride" format="string" />
    </declare-styleable>

    <attr name="textViewStyle" format="reference" />
    <attr name="state_error" format="boolean" />
    <declare-styleable name="DesignTextView">
        <attr name="android:text" />
        <attr name="android:textColor" />
        <attr name="android:textSize" />
        <attr name="android:fontFamily" />
        <attr name="android:textStyle" />
        <attr name="android:textFontWeight" />
        <attr name="android:lineHeight" />
        <attr name="android:lineSpacingExtra" />
        <attr name="android:lineSpacingMultiplier" />
        <attr name="android:letterSpacing" />
        <attr name="android:textAppearance" />
        <attr name="android:enabled" />
        <attr name="variant">
            <enum name="standard" value="0" />
            <enum name="optional" value="1" />
        </attr>
        <attr name="typography">
            <enum name="label" value="0" />
            <enum name="caption" value="1" />
            <enum name="body" value="2" />
        </attr>
        <attr name="textColorRole">
            <enum name="foreground" value="0" />
            <enum name="muted" value="1" />
            <enum name="disabled" value="2" />
            <enum name="error" value="3" />
            <enum name="primary" value="4" />
        </attr>
        <attr name="error" />
        <attr name="android:drawableStart" />
        <attr name="android:drawableEnd" />
        <attr name="android:drawablePadding" />
        <attr name="iconStart" format="reference" />
        <attr name="iconEnd" format="reference" />
        <attr name="showIconStart" format="boolean" />
        <attr name="showIconEnd" format="boolean" />
        <attr name="iconPadding" format="dimension" />
        <attr name="iconStartContentDescription" format="string" />
        <attr name="iconEndContentDescription" format="string" />
        <attr name="errorTextColor" format="color|reference" />
        <attr name="disabledTextColor" format="color|reference" />
    </declare-styleable>
</resources>
